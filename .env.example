# ===== 任务看板 环境变量示例 =====
# 用法：复制本文件为 .env（仓库根目录）后按需修改。
#   开发：docker compose --env-file .env -f docker/docker-compose.dev.yml up -d
#   生产：docker compose --env-file .env -f docker/docker-compose.yml up -d --build

# ---- 数据库 ----
# 本地开发（Docker Desktop / 本机 postgres）用 localhost。
# 若本机 5432 已被别的服务占用，改 POSTGRES_PORT 与 DATABASE_URL 里的端口即可。
DATABASE_URL=postgresql://kanban:kanban_dev_pass@localhost:5432/taskboard
POSTGRES_USER=kanban
POSTGRES_PASSWORD=kanban_dev_pass
POSTGRES_DB=taskboard
POSTGRES_PORT=5432

# ---- 后端 ----
# 生产务必替换为随机长字符串：openssl rand -hex 32
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=3000
# 初始管理员（仅当库中无任何用户时创建），首次登录后请立即改密
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=admin
ADMIN_INITIAL_PASSWORD=Admin@123456
# 仅本地演示数据（npm run db:seed:demo）用，生产勿设
# DEMO_USER_PASSWORD=Demo@123456

# ---- 前端 ----
# 开发环境走 vite 代理，保持 /api 即可
VITE_API_BASE=/api
# 留空表示同源；跨域部署时才需要填 ws://host:port
VITE_WS_URL=

# ---- 生产部署 ----
# 浏览器访问端口（宿主机）
WEB_PORT=8080
# 镜像标签，便于回滚
IMAGE_TAG=latest
# 数据库数据卷名。同一台机器要再起一套（灰度/测试环境）时改成别的名字即可互不干扰
PG_VOLUME_NAME=taskboard_pg_data
# 运行时可替换为私有仓库地址，例如 registry.example.com/library/postgres:16-alpine
IMAGE_POSTGRES=postgres:16-alpine
IMAGE_NGINX=nginx:1.27-alpine
